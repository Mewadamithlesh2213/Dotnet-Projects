@model practice1.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow-lg border-danger">

                <div class="card-header bg-danger text-white text-center">
                    <h3>Delete Employee</h3>
                </div>

                <div class="card-body">

                    <div class="alert alert-warning text-center">
                        <strong>Warning!</strong> Are you sure you want to delete this employee?
                    </div>

                    <table class="table table-bordered">

                        <tr>
                            <th>First Name</th>
                            <td>@Model.FirstName</td>
                        </tr>

                        <tr>
                            <th>Last Name</th>
                            <td>@Model.LastName</td>
                        </tr>

                        <tr>
                            <th>Phone</th>
                            <td>@Model.Phone</td>
                        </tr>

                        <tr>
                            <th>Department</th>
                            <td>@Model.Department</td>
                        </tr>

                    </table>

                    <form asp-action="Delete">

                        <input type="hidden" asp-for="EmpId" />

                        <div class="d-flex justify-content-between">

                            <button type="submit" class="btn btn-danger">
                                Delete Employee
                            </button>

                            <a asp-action="List" class="btn btn-secondary">
                                Back to List
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>